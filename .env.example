# Airtable personal access token (starts with "pat...")
AIRTABLE_API_KEY=pat_your_api_key_here

# Airtable base ID (starts with "app...")
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Name of the table containing teacher records
AIRTABLE_TABLE_NAME=Teachers

# Express server port (Vite proxies /api here during dev)
PORT=3001
